<mujoco model="mini-puppet">
  <!-- Freejoint + arm: exercises the Menagerie-like playback+BC path. -->
  <compiler angle="radian"/>
  <default>
    <joint limited="true" range="-2.5 2.5"/>
    <position kp="200" dampratio="1" inheritrange="1"/>
  </default>
  <worldbody>
    <light pos="0 0 3"/>
    <geom type="plane" size="2 2 0.05" rgba="0.2 0.25 0.3 1"/>
    <body name="pelvis" pos="0 0 0.79">
      <freejoint name="floating_base"/>
      <geom type="capsule" fromto="0 0 0 0 0 0.28" size="0.06" rgba="0.85 0.7 0.25 1"/>
      <body name="right_shoulder_pitch_link" pos="0 -0.12 0.22">
        <joint name="right_shoulder_pitch_joint" axis="0 1 0"/>
        <geom type="capsule" fromto="0 0 0 0.18 0 0" size="0.03" rgba="0.7 0.7 0.75 1"/>
        <body name="right_elbow_link" pos="0.18 0 0">
          <joint name="right_elbow_joint" axis="0 1 0"/>
          <geom type="capsule" fromto="0 0 0 0.18 0 0" size="0.025" rgba="0.6 0.65 0.7 1"/>
          <body name="right_wrist_yaw_link" pos="0.18 0 0">
            <geom type="sphere" size="0.035" rgba="0.9 0.4 0.3 1"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <position name="right_shoulder_pitch_joint" joint="right_shoulder_pitch_joint"/>
    <position name="right_elbow_joint" joint="right_elbow_joint"/>
  </actuator>
  <keyframe>
    <key name="stand" qpos="0 0 0.79 1 0 0 0 0 0" ctrl="0 0"/>
  </keyframe>
</mujoco>
